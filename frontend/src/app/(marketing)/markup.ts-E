/* Static markup for the landing page, ported from the design reference.
   Rendered once via dangerouslySetInnerHTML: the behaviour in behavior.ts owns
   this subtree imperatively, so React must treat it as opaque. */
export const LANDING_MARKUP = "<a class=\"skip\" href=\"#main\">Skip to content</a>\n\n<header class=\"hdr\" id=\"hdr\">\n  <div class=\"hdr-in\">\n    <a class=\"logo\" href=\"#top\" aria-label=\"Recall, back to top\"><span class=\"mark\" aria-hidden=\"true\"></span>Recall</a>\n    <nav class=\"nav\" aria-label=\"Primary\">\n      <a href=\"#distill\">Moments</a><a href=\"#ask\">Ask</a><a href=\"#signals\">Features</a><a href=\"#method\">How it works</a>\n    </nav>\n    <div class=\"hdr-r\">\n      <button class=\"askbtn\" id=\"palBtn\" type=\"button\" aria-haspopup=\"dialog\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n        Ask the room <kbd id=\"kbdHint\">Ctrl K</kbd>\n      </button>\n      <a class=\"btn btn-sm\" href=\"/calls\" data-mag>Open Recall</a>\n      <button class=\"burger\" id=\"burger\" type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"sheet\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path id=\"burgerPath\" d=\"M4 8h16M4 16h16\"/></svg>\n      </button>\n    </div>\n  </div>\n</header>\n<div class=\"sheet\" id=\"sheet\" aria-hidden=\"true\">\n  <a href=\"#distill\">Moments</a><a href=\"#ask\">Ask</a><a href=\"#signals\">Features</a><a href=\"#method\">How it works</a>\n  <a class=\"btn\" href=\"/calls\">Open Recall</a>\n</div>\n\n<main id=\"main\">\n\n<!-- ================= HERO ================= -->\n<section class=\"hero\" id=\"top\" aria-label=\"Introduction\">\n  <div class=\"lamp\" aria-hidden=\"true\"></div>\n  <div class=\"wrap hero-grid\">\n    <div class=\"hero-copy\">\n      <h1 class=\"hl\" id=\"hl\"><span class=\"ln\">Stay in the room.</span><span class=\"ln\">Keep the rest.</span></h1>\n      <p class=\"lede\">Recall is a video and audio memory for the conversations that matter. It listens closely, so you can be fully there.</p>\n      <div class=\"cta-row\">\n        <a class=\"btn\" href=\"#start\" data-mag>Send Recall to a meeting\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        <span class=\"micro\">No setup theater. Just press record.</span>\n      </div>\n    </div>\n    <div class=\"room\" id=\"room\">\n      <div class=\"room-top\">\n        <span class=\"room-title\"><i class=\"rec-dot\"></i>Direction session</span>\n        <span class=\"room-meta\"><b id=\"momCount\">0</b> moments found \u00b7 <span class=\"tnum\" id=\"roomClock\">00:00</span></span>\n      </div>\n      <div class=\"tiles\" id=\"tiles\"></div>\n      <div class=\"cap\" id=\"cap\" aria-live=\"off\"></div>\n    </div>\n  </div>\n  <div class=\"wrap rib-wrap\">\n    <div class=\"ribbon\" id=\"heroRibbon\">\n      <div class=\"pins\"></div>\n      <div class=\"cvw\" tabindex=\"0\" role=\"slider\" aria-label=\"Meeting timeline\" aria-valuemin=\"0\" aria-valuemax=\"3492\" aria-valuenow=\"0\">\n        <canvas></canvas><div class=\"tag\">00:00</div><div class=\"hov\"></div>\n      </div>\n    </div>\n    <div class=\"rib-ctl\">\n      <button class=\"pp\" id=\"heroPP\" type=\"button\" aria-label=\"Pause playback\"></button>\n      <span class=\"tnum\">58:12 in the room</span>\n      <span class=\"hint\">Drag across the ribbon to move through it.</span>\n    </div>\n  </div>\n  <div class=\"hero-end\"></div>\n</section>\n\n<!-- ================= MOMENTS ================= -->\n<section class=\"distill\" id=\"distill\" aria-labelledby=\"distill-h\">\n  <div class=\"pinbox\">\n    <div class=\"wrap distill-grid\">\n      <div class=\"distill-copy\">\n        <h2 class=\"h2\" id=\"distill-h\">The room gets to stay human.</h2>\n        <div class=\"phases\" id=\"phases\">\n          <p class=\"on\">Fifty-eight minutes, every word kept. You don't have to read any of it.</p>\n          <p>Recall listens for what changed: decisions, risks, open questions, and who said yes.</p>\n          <p>Five moments, under a minute to read. The rest stays searchable.</p>\n        </div>\n        <div class=\"meter\" aria-hidden=\"true\">\n          <span class=\"meter-n\" id=\"meterN\">58:12</span><span class=\"meter-l\">to read</span>\n          <div class=\"meter-b\"><i id=\"meterB\"></i></div>\n        </div>\n      </div>\n      <div class=\"paper\" id=\"paper\">\n        <div class=\"paper-head\">\n          <div><b>Onboarding flow review</b><small>Mara, Jonah, Priya, Theo</small></div>\n          <div class=\"seg\" role=\"group\" aria-label=\"Transcript view\">\n            <button type=\"button\" id=\"segT\" aria-pressed=\"true\">Transcript</button>\n            <button type=\"button\" id=\"segD\" aria-pressed=\"false\">Moments</button>\n          </div>\n        </div>\n        <div class=\"paper-win\"><div class=\"paper-in\" id=\"doc\"></div></div>\n        <div class=\"paper-foot\"><span>17 lines, 58:12</span><span id=\"paperCount\">Everything kept</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= ASK ================= -->\n<section class=\"sec\" id=\"ask\" aria-labelledby=\"ask-h\">\n  <div class=\"wrap ask-grid\">\n    <div>\n      <h2 class=\"h2\" id=\"ask-h\">Don't replay the meeting. Return to the moment.</h2>\n      <p class=\"p\">A conversation isn't a file. It's a sequence of shifts. Ask in your own words and Recall takes you to the second it happened.</p>\n    </div>\n    <div class=\"console\">\n      <form class=\"ask-form\" id=\"askForm\" autocomplete=\"off\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n        <input id=\"askIn\" type=\"text\" placeholder=\"Ask the room what changed\u2026\" aria-label=\"Ask the room what changed\" spellcheck=\"false\">\n        <button class=\"btn\" type=\"submit\">Ask</button>\n      </form>\n      <div class=\"qchips\" id=\"qchips\"></div>\n      <div class=\"ask-body\">\n        <div class=\"ans\" id=\"ans\" aria-live=\"polite\"><p class=\"hint\">Ask about decisions, owners, or risks. Every answer links to the second it happened.</p></div>\n        <figure class=\"moment\" id=\"moment\" style=\"margin:0\"></figure>\n      </div>\n      <p class=\"micro\" style=\"margin:22px 0 0\">Answers come from two sample calls (Meridian Health discovery and Q4 engineering planning). Inside the app, Ask searches your own calls.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ================= FEATURES ================= -->\n<section class=\"sec\" id=\"signals\" aria-labelledby=\"sig-h\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <h2 class=\"h2\" id=\"sig-h\">A memory you can navigate.</h2>\n      <p class=\"p\" style=\"margin:0\">Faces, voices, words, and what they added up to, kept together in one place.</p>\n    </div>\n    <div class=\"bento\">\n      <article class=\"cell c-video\">\n        <h3>See the whole room</h3>\n        <p class=\"d\">Video gives the transcript its context. Return to the glance, the pause, the moment it clicked.</p>\n        <div class=\"demo\">\n          <svg class=\"scene\" id=\"scene\" viewBox=\"0 0 640 270\" role=\"img\" aria-label=\"Four people at a table with gaze lines turning toward the speaker\"></svg>\n          <div class=\"stat\" id=\"sceneStat\"></div>\n          <div class=\"evs\"><span class=\"ev\">A nod at 14:11</span><span class=\"ev\">Everyone looks up at 31:30</span><span class=\"ev\">A long pause at 24:02</span></div>\n        </div>\n      </article>\n      <article class=\"cell c-audio\">\n        <h3>Hear who meant it</h3>\n        <p class=\"d\">Every voice keeps its own line, even when people talk over each other.</p>\n        <div class=\"demo\"><canvas class=\"cv-lanes\" id=\"lanes\" role=\"img\" aria-label=\"Four speaker lanes with live waveforms\"></canvas></div>\n      </article>\n      <article class=\"cell c-search\">\n        <h3>Find the thread</h3>\n        <p class=\"d\">Search by phrase, person, or feeling. Recall lands on the exact second.</p>\n        <div class=\"demo\">\n          <div class=\"s-in\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n            <input id=\"sIn\" type=\"text\" placeholder=\"Search this meeting\" aria-label=\"Search this meeting\" spellcheck=\"false\" autocomplete=\"off\"></div>\n          <div class=\"hits\" id=\"hits\" aria-live=\"polite\"></div>\n        </div>\n      </article>\n      <article class=\"cell c-sum\">\n        <h3>Leave with the shape</h3>\n        <p class=\"d\">A short summary of what was decided, what happens next, and what's still open.</p>\n        <div class=\"demo\">\n          <div class=\"sum\" id=\"sum\"></div>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- ================= METHOD ================= -->\n<section class=\"sec method\" id=\"method\" aria-labelledby=\"m-h\">\n  <div class=\"halo\" aria-hidden=\"true\"></div><div class=\"halo b\" aria-hidden=\"true\"></div>\n  <div class=\"wrap\">\n    <h2 class=\"h2\" id=\"m-h\" style=\"max-width:15ch\">Nothing to manage. Everything to keep.</h2>\n    <div class=\"m-stage\" id=\"mStage\" data-step=\"0\">\n      <div class=\"m-cv\" id=\"mCv\">\n        <canvas role=\"img\" aria-label=\"Animated visualization of audio becoming organized, searchable memory\"></canvas>\n        <div class=\"m-lanes\" id=\"mLanes\"></div>\n        <div class=\"m-call\" id=\"mCall\">14:18 \u00b7 Decision captured</div>\n      </div>\n      <div class=\"m-steps\" id=\"mSteps\">\n        <button class=\"m-step\" type=\"button\" aria-pressed=\"true\"><b><em>1</em>Capture</b><span>One tap holds the room: video, audio, voices, and the tiny pauses between them.</span></button>\n        <button class=\"m-step\" type=\"button\" aria-pressed=\"false\"><b><em>2</em>Understand</b><span>Language intelligence separates decisions, questions, people, and the useful in-between.</span></button>\n        <button class=\"m-step\" type=\"button\" aria-pressed=\"false\"><b><em>3</em>Return</b><span>Search the memory by phrase, person, or feeling and land on the exact second.</span></button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= TRUST ================= -->\n<section class=\"sec\" id=\"trust\" aria-labelledby=\"tr-h\" style=\"padding-top:clamp(40px,6vw,80px)\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\" id=\"tr-h\" style=\"max-width:16ch\">Private by design.</h2>\n    <div class=\"trust-grid\">\n      <div class=\"tcell\"><div class=\"tbig\"><span data-to=\"1.2\" data-dec=\"1\">0</span><small>M+</small></div><div class=\"tlbl\">rooms kept private</div></div>\n      <div class=\"tcell\"><div class=\"tbig\"><span data-to=\"94\">0</span><small>%</small></div><div class=\"tlbl\">moments found on the first search</div></div>\n      <div class=\"tcell\"><div class=\"tbig\"><span data-to=\"11\">0</span><small>min</small></div><div class=\"tlbl\">saved per meeting, on average</div></div>\n      <div class=\"tcell\"><div class=\"tbig\"><span data-to=\"0\">0</span></div><div class=\"tlbl\">conversations used for training</div></div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= START ================= -->\n<section class=\"sec start\" id=\"start\" aria-labelledby=\"st-h\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\" id=\"st-h\">Be there for it.</h2>\n    <p class=\"p\" id=\"stP\">Paste the link to your next meeting. Recall joins, listens, and files the notes.</p>\n    <div class=\"stage\" id=\"stage\">\n      <form class=\"send\" id=\"sendForm\" autocomplete=\"off\" novalidate>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14M4 6h9a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z\"/></svg>\n        <input id=\"sendUrl\" type=\"text\" inputmode=\"url\" placeholder=\"Paste a Google Meet link\" aria-label=\"Google Meet link\" spellcheck=\"false\">\n        <button class=\"btn\" id=\"sendBtn\" type=\"submit\">Send Recall<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>\n      </form>\n      <div class=\"jobcard\" id=\"jobCard\" hidden>\n        <div class=\"job-row\"><i class=\"rec-dot\" id=\"jobDot\"></i><b id=\"jobTitle\"></b><span class=\"job-st\" id=\"jobSt\"></span></div>\n        <p class=\"job-msg\" id=\"jobMsg\" aria-live=\"polite\"></p>\n        <div class=\"job-act\"><a class=\"link\" id=\"jobOpen\" href=\"/calls\" hidden>Open the notes <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a><button class=\"link\" id=\"jobAgain\" type=\"button\" hidden>Send to another meeting</button></div>\n      </div>\n    </div>\n    <p class=\"fine\">Recall joins as a named guest and posts a notice in the chat. The host has to let it in.</p>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-top\">\n      <div>\n        <a class=\"logo\" href=\"#top\"><span class=\"mark\" aria-hidden=\"true\"></span>Recall</a>\n        <p class=\"foot-p\">A memory for conversations that matter. Private by design, built for the present.</p>\n        <button class=\"askbtn\" id=\"palBtn2\" type=\"button\" style=\"margin-top:22px\" aria-haspopup=\"dialog\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n          Search memory <kbd class=\"kbdx\">Ctrl K</kbd></button>\n      </div>\n      <nav class=\"foot-links\" aria-label=\"Footer\">\n        <b>Product</b><a href=\"#distill\">Moments</a><a href=\"#ask\">Ask</a><a href=\"#signals\">Features</a><a href=\"#method\">How it works</a><a href=\"#start\">Start listening</a>\n      </nav>\n    </div>\n    <div class=\"foot foot-base\"><span>Private by design</span><span>Built for the present</span><span>\u00a9 2026 Recall</span></div>\n  </div>\n</footer>\n\n<div class=\"dock\" id=\"dock\" aria-label=\"Page position\">\n  <span class=\"dock-t\" id=\"dockT\">00:00</span>\n  <div class=\"dock-track\"><div class=\"dock-bars\" id=\"dockBars\"></div><div class=\"dock-ticks\" id=\"dockTicks\"></div></div>\n  <span class=\"dock-l\" id=\"dockL\">Room</span>\n</div>\n\n<div class=\"pal\" id=\"pal\" hidden>\n  <div class=\"pal-box\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Ask the room\">\n    <div class=\"pal-in\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>\n      <input id=\"palIn\" type=\"text\" placeholder=\"Ask a question or jump to a section\" aria-label=\"Ask a question or jump to a section\" autocomplete=\"off\" spellcheck=\"false\">\n      <kbd>Esc</kbd>\n    </div>\n    <div class=\"pal-list\" id=\"palList\" role=\"listbox\"></div>\n  </div>\n</div>\n";
